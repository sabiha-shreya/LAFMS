# ========================================================
# Campus Lost & Found Management System - Environment Config
# ========================================================

# Application Port (defaults to 3000 for local dev)
PORT=3000

# Session Secret (change this in production on Vercel)
SESSION_SECRET=lafms_super_secret_session_key_2026_change_me

# ========================================================
# DATABASE CONFIGURATION
# ========================================================
# Note: If no DB credentials are provided, the application
# automatically runs in embedded SQLite mode (pre-loaded with
# all seed data from Dump20261122.sql) so you can test immediately
# without configuring any database.
#
# For production on Vercel, connect any free cloud MySQL service
# (e.g. TiDB Serverless, Aiven, Railway, PlanetScale, Supabase/Neon MySQL):
#
# Option A: Single Connection URL
# DATABASE_URL=mysql://user:password@host:3306/campus_lost_found?ssl={"rejectUnauthorized":true}
#
# Option B: Individual Connection Parameters
# DB_HOST=your-mysql-host.example.com
# DB_PORT=3306
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_NAME=campus_lost_found
# DB_SSL=true

